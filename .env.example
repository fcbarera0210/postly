# Neon (solo servidor; no uses NUXT_PUBLIC_ para la URL de la BD)
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Opcional pero recomendado: Nitro lee antes process.env que runtimeConfig.
# Si en local la API no ve tu BD, duplica aquí el mismo valor que DATABASE_URL.
# NUXT_DATABASE_URL="postgresql://..."

# Secreto para firmar JWT (obligatorio en producción).
NUXT_SESSION_SECRET="genera-un-string-largo-aleatorio"
